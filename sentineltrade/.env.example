# SentinelTrade — modelo de variáveis de ambiente.
# Copie para ".env" (que é ignorado pelo Git) e preencha localmente.
# Este arquivo contém APENAS NOMES de variáveis: nunca coloque valores reais aqui.

# memory = dados em memória (padrão, sem banco)  |  jdbc = PostgreSQL
SENTINEL_STORAGE=memory
# true = carrega usuários/saldos SIMULADOS de demonstração (com JDBC, usar só em ambiente de teste)
SENTINEL_DEMO=false
SENTINEL_ZONE=America/Sao_Paulo

# --- Banco de dados (somente quando SENTINEL_STORAGE=jdbc) ---
DB_URL=jdbc:postgresql://localhost:5432/sentineltrade
DB_USER=
DB_PASSWORD=
# senha do papel de menor privilégio criado por database/hardening-postgres.sql
APP_DB_PASSWORD=

# --- Segurança ---
# custo do PBKDF2 (OWASP 2023: >= 600000)
PBKDF2_ITERATIONS=600000

# --- Integração com a corretora simulada (resiliência) ---
BROKER_TIMEOUT_MS=2000
BROKER_CIRCUIT_FAILURES=5
BROKER_CIRCUIT_OPEN_SECONDS=30

# --- Senhas das contas de demonstração (opcional; se vazias, são geradas aleatoriamente a cada execução) ---
DEMO_PASSWORD_ADMIN=
DEMO_PASSWORD_RISCO=
DEMO_PASSWORD_INVESTIDOR_A=
DEMO_PASSWORD_INVESTIDOR_B=
